{
  "name": "@was35/dsh-reclaim",
  "version": "0.1.1",
  "description": "Audit DeepSeek Harness disk usage (sessions, attachments, rebuildable caches), classify it by risk, and move anything you choose to delete into the plugin's own recoverable trash. The model can query, never delete.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --import ./test/hooks/register.mjs --test test/",
    "test:host": "sh scripts/verify-host.sh",
    "test:all": "npm test && npm run test:host"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/safety.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "storage",
    "cleanup",
    "disk-usage",
    "disk-space",
    "audit",
    "quarantine"
  ],
  "license": "MIT",
  "author": "gankudadiz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/was35/dsh-reclaim.git"
  },
  "bugs": {
    "url": "https://github.com/was35/dsh-reclaim/issues"
  },
  "homepage": "https://github.com/was35/dsh-reclaim#readme",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.5-rc.1 <0.3.0-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.1 <0.3.0-0 || >=0.1.6-0 <0.1.7-0 || >=0.1.7-0 <0.1.8-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  }
}
