# 依赖
node_modules/
.pnpm-store/

# 注意：不要忽略 lib/ 与 client/
# 本插件用 ESM JavaScript 直接编写（无构建步骤），lib/index.js 就是源码本体；
# 且 DSH 插件必须提交 lib/（参考 dsh-lsp-actions / dsh-easyrewrite / dshmarket
# 的 package.json files 字段都含 "lib"），否则使用者无法直接安装。

# 测试与覆盖率
coverage/
.nyc_output/
*.lcov

# 编辑器与操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与环境
*.log
npm-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# 打包产物
*.tgz
